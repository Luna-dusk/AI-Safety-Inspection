# ── 复制为 .env 后填真实值；真实 key 只存在于服务器环境变量，绝不进仓库（A.12 #2）──

# 服务
HOST=0.0.0.0
PORT=80

# 设备鉴权：允许的设备 ID（逗号分隔）；可选 "设备ID:token" 形式的 token 表
DEVICE_IDS=DC1
DEVICE_TOKENS=

# ── 火山 TTS（双向流式 V3，wss://openspeech.bytedance.com/api/v3/tts/bidirection）──
# 新版控制台只填 VOLC_TTS_API_KEY；旧版控制台填 APP_ID + ACCESS_TOKEN
VOLC_TTS_API_KEY=
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
# seed-tts-2.0 / seed-tts-1.0 / seed-tts-1.0-concurr（决定音色范围与计费）
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# 音色 ID（A.12 #3 待定：选 2-3 个温柔女声试听）。
# ⚠️ seed-tts-2.0 只认 `_uranus_bigtts` 后缀音色；1.0 的 `_mars_bigtts` 会报
# 55000000 resource mismatch。已验证可用的 2.0 音色：
#   zh_female_vv_uranus_bigtts（温柔女声，当前默认）
#   zh_female_sophie_uranus_bigtts / zh_male_liufei_uranus_bigtts
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
# 语速：V3 标度 [-50,100]，100=2.0 倍速；-15 ≈ 0.85 倍速（A.4.2 老人友好）
VOLC_TTS_SPEECH_RATE=-15
# 音调半音 [-12,12]；A.4.2 的 pitch_ratio 0.95 ≈ -1，试听后再定，0 为不传
VOLC_TTS_PITCH=0

# ── 火山 ASR（大模型流式识别，wss://…/api/v3/sauc/bigmodel_async）──
VOLC_ASR_API_KEY=
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
# ⚠️ 流式语音识别 2.0 = volc.seedasr.sauc.duration / .concurrent；
# 1.0 才是 volc.bigasr.sauc.*（用错报 403 "resource not granted"）
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# ── LLM（deepseek 官方直连，A.6）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 需求 A.6 写 deepseek-flash；以实际开通的模型名为准
DEEPSEEK_MODEL=deepseek-flash
# 思考程度：off=关闭思考（推荐，实测正文 TTFT 2.11s→0.59s）/
# minimal|low|medium|high（reasoning_effort）/ default=模型默认（flash 默认开思考，慢）
LLM_THINKING=off
LLM_MAX_TOKENS=120
LLM_TEMPERATURE=0.7

# ── 行为开关 ──
# A.5 分句器：V3 官方最佳实践是 LLM delta 直喂（无需切句）；实测遇到"无标点不合成"再置 1
SPLIT_TEXT=0
# A.10 文字留痕：1 = 只记 asr/reply 文本到 TEXT_LOG_PATH（默认不记）
RECORD_TEXT=0
TEXT_LOG_PATH=/var/log/aichat/text.jsonl
# 开机问候文案（X-Greeting=1 时直接 TTS，不走 LLM）
GREETING_TEXT=奶奶早，今天感觉怎么样？
# TTS 连接空闲回收（A.4.4 坑 4：空闲 >60s 主动断）
TTS_IDLE_CLOSE_MS=60000
# 会话上下文兜底过期（设备正常会发 DELETE；这里是防御值）
SESSION_TTL_MS=900000

# ── v2 WebSocket（附录 B；v1 HTTP 轮次制保留为降级路径）──
# 协议级 ping 周期（秒）：空闲连接的保活与断线探测
WS_HEARTBEAT_S=30
# 建连后等 hello 的超时（秒），超时即断
WS_HELLO_TIMEOUT_S=10
# 轮内看门狗（毫秒）：turn_start 后这么久没有任何上行消息，按说完收尾
WS_TURN_IDLE_MS=10000
# 单轮上行上限（字节）：480KB = 15s PCM（A.3.1），超过截断
WS_MAX_AUDIO_BYTES=491520
